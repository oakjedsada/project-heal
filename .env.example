# Copy this file to .env (gitignored, never committed) and fill in real
# values to make "ลืมรหัสผ่าน" (forgot password) send a real email instead of
# showing the reset link in the API response.
#
# Easiest option: Gmail SMTP with an App Password (free, no new service to
# sign up for).
#   1. Enable 2-Step Verification on the Google account: https://myaccount.google.com/security
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#   3. Fill in SMTP_USERNAME with that Gmail address and SMTP_PASSWORD with
#      the 16-character App Password (not your regular Google password).
#
# Leave any of these blank (or don't create .env at all) and the app falls
# back to returning the reset link directly instead of emailing it — the
# feature still works end-to-end either way.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=MindCheck
